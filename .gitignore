# Secrets — never commit
.env
.env.*
!.env.example

# Personal Claude Code instructions + working scratch (not shared)
CLAUDE.local.md
PROGRESS.md
# Machine-local permissions/settings — .claude/settings.json IS shared, this one isn't
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
.vite/

# Design references — other people's screenshots, and this repo is public.
# Allowlist shape on purpose: a new binary type can't sneak in by extension.
design/refs/*
!design/refs/NOTES.md
!design/refs/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Cloudflare Workers local state and esbuild output (worker/*/.wrangler/).
.wrangler/
